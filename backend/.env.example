# =============================================================================
# SevaSangam Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example belongs in version control.
# =============================================================================

# --- PostgreSQL + PostGIS ---------------------------------------------------
POSTGRES_USER=sevasangam
POSTGRES_PASSWORD=sevasangam_dev
POSTGRES_DB=sevasangam
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# SQLAlchemy async connection string (constructed from the vars above)
# Format: postgresql+asyncpg://user:password@host:port/db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- App --------------------------------------------------------------------
APP_ENV=development
# SECRET_KEY=<generate-a-random-secret-for-jwt>
